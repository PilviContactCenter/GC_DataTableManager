# Public OAuth client ID configured for Authorization Code + PKCE.
GENESYS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SDK region key, for example eu_central_1 or us_east_1.
GENESYS_REGION=eu_central_1
# IDs of two groups created in Genesys Cloud.
GENESYS_ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000001
GENESYS_USER_GROUP_ID=00000000-0000-0000-0000-000000000002
# Public HTTPS hostname pointing to your Docker host.
APP_DOMAIN=datatable.example.com
